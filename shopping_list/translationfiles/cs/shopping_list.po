msgid "Delete \"{name}\"? Items in this area will become uncategorized."
msgstr "Smazat \"{name}\"? Položky z této oblasti budou bez kategorie."

#: src/components/PublicListView.vue
msgid "Add an item to list..."
msgstr "Přidat položku do seznamu..."

#: src/components/ItemEditor.vue
msgid "Add an item or paste a list..."
msgstr "Přidat položku nebo vložit seznam..."

#. Accessible name and tooltip of the round question-mark button in the add box
#: src/components/ItemEditor.vue
msgid "Input format help"
msgstr "Nápověda k formátování vstupu"

#: src/components/ItemEditor.vue
msgid "Type one item, or paste a whole list"
msgstr "Zadejte jednu položku nebo vložte celý seznam"

#: src/components/ItemEditor.vue
msgid "Every pasted line becomes its own item. Amounts, units and list markers are read for you."
msgstr "Každý vložený řádek se stane položkou. Částky, jednotky a značky seznamu se přečtou."

#. Column heading in the input help: the example line as the user would type it
#: src/components/ItemEditor.vue
msgid "You type"
msgstr "Zadali jste"

#. Column heading in the input help: the item the app makes from that line
#: src/components/ItemEditor.vue
msgid "You get"
msgstr "Dostanete"

#. Example line in the input help. Translate the words, keep the "- " bullet.
#: src/utils/inputExamples.ts
msgid "- Apples"
msgstr "- jablka"

#. Example line in the input help. Translate the words, keep the "[ ] " checkbox and the number.
#: src/utils/inputExamples.ts
msgid "[ ] 3 Bananas"
msgstr "[ ] 3 banány"

#. Example line in the input help. Translate the word, keep the "[x] " ticked checkbox.
#: src/utils/inputExamples.ts
msgid "[x] Eggs"
msgstr "[x] vejce"

#. Example line in the input help. Use a unit from your language's parsing pack so it is recognised.
#: src/utils/inputExamples.ts
msgid "2 cups flour"
msgstr "2 šálky mouky"

#. Example line in the input help. Translate the word, keep the "1. " numbering.
#: src/utils/inputExamples.ts
msgid "1. Milk"
msgstr "1. mléko"

