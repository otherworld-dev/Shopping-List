#: src/App.vue
msgid "No list selected"
msgstr "Není vybrán žádný seznam"

#: src/App.vue
msgid "Select a list from the sidebar or create a new one"
msgstr "Vyberte seznam z postranního panelu nebo vytvořte nový seznam"

#: src/PublicApp.vue
msgid "Password required"
msgstr "Heslo je vyžadováno"

#: src/PublicApp.vue
msgid "This list is password protected."
msgstr "Tento seznam je chráněný heslem."

#: src/PublicApp.vue
msgid "Enter password"
msgstr "Zadejte heslo"

#: src/PublicApp.vue
msgid "Unlock"
msgstr "Odemknout"

#: src/PublicApp.vue
msgid "Incorrect password"
msgstr "Nesprávné heslo"

#: src/PublicApp.vue
msgid "Not found"
msgstr "Nenalezeno"

#: src/PublicApp.vue
msgid "This shared list does not exist or has expired."
msgstr "Tento sdílený seznam neexistuje nebo vypršela jeho platnost."

