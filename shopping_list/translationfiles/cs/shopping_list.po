#: src/components/AreaKeywordsSettings.vue src/components/ListSidebar.vue
msgid "Manage Areas"
msgstr "Správa oblastí"

#: src/components/AreaKeywordsSettings.vue
msgid "Manage shop areas, keywords, and display order. Keywords auto-detect which area an item belongs to when added or pasted."
msgstr "Spravovat oblasti nakupování, klíčová slova a zobrazení pořadí položek. Klíčová slova jsou použita k automatickému rozpoznání oblastí, do kterých položka patří."

#: src/components/AreaKeywordsSettings.vue
msgid "Search keywords..."
msgstr "Vyhledat klíčová slova..."

#: src/components/AreaKeywordsSettings.vue
msgid "Add keyword..."
msgstr "Přidat klíčové slovo..."

#: src/components/AreaKeywordsSettings.vue
msgid "No keywords"
msgstr "Žádná klíčová slova"

#: src/components/AreaKeywordsSettings.vue
msgid "Rename"
msgstr "Přejmenovat"

#: src/components/AreaKeywordsSettings.vue
msgid "Delete area"
msgstr "Smazat oblast"

#: src/components/AreaKeywordsSettings.vue
msgid "Move up"
msgstr "Posunout nahoru"

#: src/components/AreaKeywordsSettings.vue
msgid "Move down"
msgstr "Posunout dolů"

