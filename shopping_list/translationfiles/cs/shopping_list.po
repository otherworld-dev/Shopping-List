msgid "No items yet"
msgstr "Zatím žádné položky"

#: src/components/ListView.vue
msgid "Add your first item above"
msgstr "Výše přidejte svoji první položku"

#: src/components/ListView.vue src/components/PublicListView.vue
msgid "Uncategorized"
msgstr "Bez kategorie"

#: src/components/ListView.vue src/components/PublicListView.vue src/components/ItemEditor.vue
msgid "Checked off"
msgstr "Odškrtnuto"

#: src/components/ListView.vue
msgid "Restore all"
msgstr "Obnovit vše"

#: src/components/ListView.vue
msgid "Delete all"
msgstr "Smazat vše"

#. Heading in the list's menu, above the three ways to order the open items.
#: src/components/ListView.vue
msgid "Sort items"
msgstr "Seřadit položky"

#. Heading in the list's menu, above the three ways to order the checked-off section.
#: src/components/ListView.vue
msgid "Sort checked-off items"
msgstr "Seřadit odškrtnuté položky"

#. Sort option, used for both open and checked-off items: grouped by shop area, in the area order of the list.
#: src/components/ListView.vue
msgid "By area"
msgstr "Podle oblasti"

#. Sort option for open items: grouped by shop area, and by name inside each area.
#: src/components/ListView.vue
msgid "By area, A to Z"
msgstr "Podle oblasti, A až Z"

#. Sort option, used for both open and checked-off items: by name, ignoring the shop areas.
#: src/components/ListView.vue
msgid "A to Z"
msgstr "Od A do Z"

#. Sort option for checked-off items: the item checked off last comes first.
#: src/components/ListView.vue
msgid "Most recent first"
msgstr "Od nejnovějších"

